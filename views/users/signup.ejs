
<% layout("/layouts/boilerplate") %>

<div class="signup-page">
    <div class="signup-card">
        <div class="signup-heading">
            <div class="signup-icon">
                <i class="fa-solid fa-compass"></i>
            </div>

            <h1>Join Wanderlust</h1>
            <p>Create your account and start exploring unique stays.</p>
        </div>

        <form action="/signup" method="POST" class="signup-form needs-validation" novalidate>
            <div class="signup-field">
                <label for="username" class="form-label">Username</label>
                <div class="signup-input-wrap">
                    <i class="fa-regular fa-user input-icon"></i>
                    <input
                        class="form-control signup-input"
                        required
                        minlength="3"
                        maxlength="30"
                        type="text"
                        name="username"
                        id="username"
                        placeholder="Choose a username"
                        autocomplete="username"
                    >
                    <div class="invalid-feedback">Please enter a username with at least 3 characters.</div>
                </div>
            </div>

            <div class="signup-field">
                <label for="email" class="form-label">Email address</label>
                <div class="signup-input-wrap">
                    <i class="fa-regular fa-envelope input-icon"></i>
                    <input
                        class="form-control signup-input"
                        required
                        type="email"
                        name="email"
                        id="email"
                        placeholder="you@example.com"
                        autocomplete="email"
                    >
                    <div class="invalid-feedback">Please enter a valid email address.</div>
                </div>
            </div>

            <div class="signup-field">
                <label for="password" class="form-label">Password</label>
                <div class="signup-input-wrap">
                    <i class="fa-solid fa-lock input-icon"></i>
                    <input
                        class="form-control signup-input"
                        required
                        minlength="8"
                        type="password"
                        name="password"
                        id="password"
                        placeholder="Create a strong password"
                        autocomplete="new-password"
                        aria-describedby="password-help"
                    >
                    <div class="invalid-feedback">Password must contain at least 8 characters.</div>
                </div>
                <small id="password-help" class="password-help">Use at least 8 characters.</small>
            </div>

            <button type="submit" class="signup-submit">
                <span>Create Account</span>
                <i class="fa-solid fa-arrow-right"></i>
            </button>

            <p class="signup-login">
                Already have an account?
                <a href="/login">Log in</a>
            </p>
        </form>

        <div class="signup-footer-note">
            <i class="fa-solid fa-shield-halved"></i>
            Your journey starts here.
        </div>
    </div>
</div>

<script>
    const signupForm = document.querySelector(".signup-form");

    if (signupForm) {
        signupForm.addEventListener("submit", (event) => {
            if (!signupForm.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
            }

            signupForm.classList.add("was-validated");
        });
    }
</script>
