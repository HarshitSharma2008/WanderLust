
<% layout("/layouts/boilerplate") %>

<script>
    const mapToken = <%- JSON.stringify(mapToken || "") %>;
    const listingData = <%- JSON.stringify({
        title: listings.title,
        geometry: listings.geometry
    }) %>;
</script>

<div class="row mt-3">
    <div class="col-12 col-md-8 offset-md-2">
        <h3><%= listings.title %></h3>
    </div>

    <div class="card col-12 col-md-8 offset-md-2 listing-card">
        <img
            src="<%= listings.image.url %>"
            class="card-img-top show-img"
            alt="listing_image"
        >

        <div class="card-body">
            <p class="card-text">
                Owned by: <i><%= listings.owner.username %></i>
            </p>
            <p class="card-text"><%= listings.description %></p>
            <p class="card-text">
                &#8377; <%= listings.price.toLocaleString("en-IN") %>
            </p>
            <p class="card-text"><%= listings.location %></p>
            <p class="card-text"><%= listings.country %></p>
        </div>
    </div>

    <% if (currUser && listings.owner._id.equals(currUser._id)) { %>
        <div class="col-12 col-md-8 offset-md-2 btns mt-3">
            <a
                href="/listings/<%= listings._id %>/edit"
                class="btn btn-dark edit-btn"
            >Edit</a>

            <form
                action="/listings/<%= listings._id %>?_method=DELETE"
                method="POST"
            >
                <button type="submit" class="btn btn-dark delete-btn">
                    Delete
                </button>
            </form>
        </div>
    <% } %>

    <div class="col-12 col-md-8 offset-md-2 mt-4">
        <hr>

        <% if (currUser) { %>
            <h4>Leave a Review</h4>

            <form
                action="/listings/<%= listings._id %>/reviews"
                method="POST"
                novalidate
                class="needs-validation"
            >
                <div class="mb-3 mt-3">
                    <label for="rating" class="form-label">Rating</label>

                    <fieldset class="starability-slot">
                        <input type="radio" id="no-rate"
                            class="input-no-rate"
                            name="review[rating]" value="1" checked
                            aria-label="No rating.">

                        <input type="radio" id="first-rate1"
                            name="review[rating]" value="1">
                        <label for="first-rate1" title="Terrible">1 star</label>

                        <input type="radio" id="first-rate2"
                            name="review[rating]" value="2">
                        <label for="first-rate2" title="Not good">2 stars</label>

                        <input type="radio" id="first-rate3"
                            name="review[rating]" value="3">
                        <label for="first-rate3" title="Average">3 stars</label>

                        <input type="radio" id="first-rate4"
                            name="review[rating]" value="4">
                        <label for="first-rate4" title="Very good">4 stars</label>

                        <input type="radio" id="first-rate5"
                            name="review[rating]" value="5">
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>

                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">Comments</label>
                    <textarea
                        name="review[comment]"
                        id="comment"
                        rows="5"
                        class="form-control"
                        required
                    ></textarea>
                    <div class="invalid-feedback">
                        Please add some comment for review.
                    </div>
                </div>

                <button type="submit" class="btn btn-outline-dark">
                    Submit
                </button>
            </form>
            <hr>
        <% } %>

        <% if (listings.reviews.length > 0) { %>
            <p><b>All Reviews</b></p>

            <div class="row">
                <% for (const review of listings.reviews) { %>
                    <div class="col-12 col-md-6 mb-3">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title">
                                    @<%= review.author.username %>
                                </h5>

                                <p
                                    class="starability-result card-text"
                                    data-rating="<%= review.rating %>"
                                ></p>

                                <p class="card-text"><%= review.comment %></p>

                                <% if (
                                    currUser &&
                                    review.author._id.equals(currUser._id)
                                ) { %>
                                    <form
                                        method="POST"
                                        action="/listings/<%= listings._id %>/reviews/<%= review._id %>?_method=DELETE"
                                    >
                                        <button
                                            type="submit"
                                            class="btn btn-sm btn-dark"
                                        >
                                            Delete
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>

    <div class="col-12 col-md-8 offset-md-2 mb-4 mt-4">
        <h3>Where you'll be</h3>
        <div id="map" role="region" aria-label="Listing location map"></div>
        <p id="map-error" class="text-danger mt-2" role="alert"></p>
    </div>
</div>

<script src="/js/map.js"></script>
