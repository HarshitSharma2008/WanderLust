
<% layout("/layouts/boilerplate") %>

<div class="new-listing-page">
    <div class="new-listing-container">
        <header class="new-listing-header">
            <span class="new-listing-eyebrow">
                <i class="fa-solid fa-compass"></i>
                Wanderlust
            </span>
            <h1>Create a New Listing</h1>
            <p>Share a special place with travellers and help them find their next memorable stay.</p>
        </header>

        <section class="new-listing-card">
            <form action="/listings" method="POST" class="new-listing-form" enctype="multipart/form-data">
                <div class="mb-4">
                    <label for="title" class="form-label">Listing title</label>
                    <input
                        class="form-control"
                        id="title"
                        name="listing[title]"
                        type="text"
                        placeholder="e.g. Peaceful villa near the mountains"
                        minlength="3"
                        maxlength="100"
                        required
                    >
                    <div class="invalid-feedback">Please enter a listing title.</div>
                </div>

                <div class="mb-4">
                    <label for="description" class="form-label">Description</label>
                    <textarea
                        class="form-control"
                        id="description"
                        name="listing[description]"
                        placeholder="Describe what makes this place special..."
                        rows="5"
                        maxlength="2000"
                        required
                    ></textarea>
                    <div class="invalid-feedback">Please enter a description.</div>
                </div>

                <div class="mb-4">
                    <label for="image" class="form-label">Listing photo</label>
                    <input
                        class="form-control"
                        id="image"
                        name="listing[image][url]"
                        type="file"
                        accept="image/*"
                    >
                    <div class="form-text">Choose a clear photo of your property. Image upload is optional.</div>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-md-4 mb-3">
                        <label for="price" class="form-label">Price per night (₹)</label>
                        <input
                            class="form-control"
                            id="price"
                            name="listing[price]"
                            type="number"
                            placeholder="e.g. 2500"
                            min="0"
                            step="any"
                            required
                        >
                        <div class="invalid-feedback">Enter a valid price.</div>
                    </div>

                    <div class="col-12 col-md-8 mb-3">
                        <label for="country" class="form-label">Country</label>
                        <input
                            class="form-control"
                            id="country"
                            name="listing[country]"
                            type="text"
                            placeholder="e.g. India"
                            autocomplete="country-name"
                            required
                        >
                        <div class="invalid-feedback">Please enter the country.</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input
                        class="form-control"
                        id="location"
                        name="listing[location]"
                        type="text"
                        placeholder="e.g. Jaipur, Rajasthan"
                        autocomplete="street-address"
                        required
                    >
                    <div class="invalid-feedback">Please enter the listing location.</div>
                </div>

                <div class="new-listing-actions">
                    <button type="submit" class="new-listing-submit">
                        <span>Create Listing</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>
            </form>
        </section>
    </div>
</div>
